root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.java]
indent_size = 4
continuation_indent_size = 8
max_line_length = 120

[*.{js,css,html,json,vue}]
indent_size = 2

[*.{gradle,properties,sql,proto}]
indent_size = 4
